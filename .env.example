# Copy to .env and fill in. NEVER commit .env.

# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Render / Supabase / Neon / local)
DATABASE_URL=postgresql://user:password@host:5432/findthem

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters. The server refuses to start without it.
JWT_SECRET=

# ── Common ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000,https://findthemindia.vercel.app

# ── Optional ──────────────────────────────────────────────────────────────────
# Face matching microservice (face_server.py). Sightings work without it.
# FACE_SERVICE_URL=https://findthem-face.onrender.com

# Transactional email via Brevo. Unset = emails are silently skipped.
# BREVO_API_KEY=
# EMAIL_FROM=no-reply@yourdomain.com

# Used once by `npm run seed` to create the first admin, then remove them.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
